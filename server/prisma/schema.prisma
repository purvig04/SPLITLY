generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  contact   String   @map("phone_no")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

    createdGroups Group[] @relation("UserToGroup") //since user can create many groups
    memberOf GroupMember[] @relation("UserToMembers") //since user can be in more than one group
    expenseCreated Expense[] @relation("UserCreatedExpenses") //one user can create many expenses 
    payer Settlement[] @relation("Payer")
    receiver Settlement[] @relation("Receiver")
      Chats         Chats[]


  @@map("users")
}

model Group {
  id          String    @id @default(uuid())
  title       String
  type        GroupType
  createdById String
  createdBy   User      @relation("UserToGroup", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members GroupMember[] @relation("GroupToMembers")
  expenses Expense[] @relation("GroupExpenses")
  settlements Settlement[] @relation("GroupSettlement")
    Chats   Chats[]


  @@map("groups")
}

enum GroupType {
  PERSONAL
  NON_GROUP
  GROUP
}

model GroupMember {
  id String @id @default(uuid())

  user   User   @relation("UserToMembers", fields: [userId], references: [id])
  userId String
  
  group Group @relation(fields: [groupId] , references: [id] , name: "GroupToMembers",onDelete: Cascade)
  groupId String

  joinedAt DateTime @default(now())

  @@map("group_members")
}

model Category{
  id String @id @default(uuid())
  name String @unique
  keywords String[] 
  icon      String?

  expenses Expense[] @relation("CategoryExpenses")
    @@index([keywords], type: Gin) 


  @@map("category")
}

model Expense{
  id String @id @default(uuid()) 
  title String
  description String?

  group Group? @relation("GroupExpenses",fields: [groupId], references: [id])
  groupId String?

  totalAmount Float

  category Category @relation("CategoryExpenses",fields: [categoryId], references: [id])
  categoryId String
   
  paid_by Json[]
  shared_amounts Json[]

  createdByUser User @relation("UserCreatedExpenses",fields: [created_by], references: [id])
  created_by String

  is_Settled Boolean @default(false)
  createdAt DateTime @default(now())  
  updatedAt DateTime @updatedAt

  @@map("expense")
} 

model Settlement{
    id String @id @default(uuid()) 

    group Group @relation("GroupSettlement",fields: [group_id], references: [id])
    group_id String

    payer User @relation("Payer",fields: [payer_id], references: [id])
    payer_id String

  receiver User @relation("Receiver",fields: [receiver_id], references: [id])
    receiver_id String

    amount Float
    created_at DateTime @default(now())

    @@map("settlement")
}

model Chats {
  id          String @id @default(uuid())
  chatMessage String @map("chat_message")

  group   Group  @relation(fields: [groupId], references: [id])
  groupId String @map("group_id")

  sender   User   @relation(fields: [senderId], references: [id])
  senderId String @map("sender_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chats")
}