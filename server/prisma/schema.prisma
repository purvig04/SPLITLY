generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  contact   String   @map("phone_no")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  createdGroups Group[]       @relation("UserToGroup") //since user can create many groups
  memberOf      GroupMember[] @relation("UserToMembers") //since user can be in more than one group
  Chats         Chats[]

  @@map("users")
}

model Group {
  id          String    @id @default(uuid())
  title       String
  type        GroupType
  createdById String
  createdBy   User      @relation("UserToGroup", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members GroupMember[] @relation("GroupToMembers")
  Chats   Chats[]

  @@map("groups")
}

enum GroupType {
  PERSONAL
  NON_GROUP
  GROUP
}

model GroupMember {
  id String @id @default(uuid())

  user   User   @relation("UserToMembers", fields: [userId], references: [id])
  userId String
  
  group Group @relation(fields: [groupId] , references: [id] , name: "GroupToMembers",onDelete: Cascade)
  groupId String

  joinedAt DateTime @default(now())

  @@map("group_members")
}

model Chats {
  id          String @id @default(uuid())
  chatMessage String @map("chat_message")

  group   Group  @relation(fields: [groupId], references: [id])
  groupId String @map("group_id")

  sender   User   @relation(fields: [senderId], references: [id])
  senderId String @map("sender_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chats")
}
